<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    松月启动器瘦身安装引导器（WiX Burn Bundle）。

    体积策略（SRS v2.6）：应用本体按「框架依赖」发布（.NET 桌面运行时与 Windows App Runtime
    不进安装包），MSI 只有应用自身（~60MB 发布产物）；两个运行时在安装时按需下载：

      1. .NET Desktop Runtime 10 (x64)
         检测：dotnet 共享目录下的钉住版本（util:FileSearch，注册表键在本机实测不可靠——
         只有 sharedhost，sharedfx 可能整个缺失）。用户装有更新补丁版时（如 10.0.14）
         不会命中钉住版 → 会再装一份钉住版（.NET 运行时按版本并排共存，无害，只发生一次）。
         兜底：检测漏网且跳过安装时，apphost 启动器自身会弹出官方「缺运行时」引导对话框。
      2. Windows App Runtime 1.8 (x64)
         无可靠检测锚点（MSIX 包不出注册表，WindowsApps 目录 ACL 拒绝枚举），
         因此不做 DetectCondition、每次安装都运行官方安装器——它幂等：已装时快速退出。
         兜底：万一运行时仍缺失，应用启动时 Bootstrap 自动初始化会弹出系统级引导对话框。

    变量由 build.ps1 注入：
      ProductVersion / Manufacturer / IconPath        同 Product.wxs
      BundleUpgradeCode                               Bundle 自身升级码（与 MSI UpgradeCode 不同：
                                                      旧版自包含 MSI 靠内部 MajorUpgrade 被新包覆盖升级）
      MsiPath                                         瘦身 MSI 的路径
      DotNetVersion / DotNetUrl / DotNetSha1 / DotNetSize
      WarUrl / WarSha1 / WarSize
  -->
  <Bundle Name="松月启动器 (A ComfyUI Launcher for ROCm)"
          Manufacturer="$(var.Manufacturer)"
          Version="$(var.ProductVersion)"
          UpgradeCode="$(var.BundleUpgradeCode)"
          IconSourceFile="$(var.IconPath)"
          DisableModify="yes"
          Compressed="yes">

    <!-- WiX 标准引导界面（rtfLicense 主题）：显示许可链接 + 安装/修复/卸载三态 UI。
         需要扩展 WixToolset.BootstrapperApplications.wixext（build.ps1 自动确保）。 -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense"
                                              LicenseUrl="https://github.com/self-exiler/SongYueLauncher"
                                              SuppressOptionsUI="no" />
    </BootstrapperApplication>

    <!-- 安装目录：应用 MSI 的 INSTALLFOLDER 由这里传入，保持与旧版相同的默认位置 -->
    <Variable Name="InstallFolder" Value="[ProgramFiles64Folder]SongYueLauncher" />

    <!-- .NET 桌面运行时检测：钉住版本的共享目录存在即视为已装 -->
    <util:FileSearch Id="DotNetDesktopRuntimeSearch"
                     Path="[ProgramFiles64Folder]dotnet\shared\Microsoft.WindowsDesktop.App\$(var.DotNetVersion)\System.Private.CoreLib.dll"
                     Result="exists"
                     Variable="DotNetInstalled" />

    <Chain>
      <!-- 每台机器只装一次（Permanent）：卸载启动器不回收系统级运行时 -->
      <ExePackage Id="DotNetDesktopRuntime"
                  DisplayName=".NET Desktop Runtime $(var.DotNetVersion) (x64)"
                  Description="松月启动器运行所需的 .NET 桌面运行时（首次安装时自动下载）"
                  PerMachine="yes"
                  Permanent="yes"
                  DetectCondition="DotNetInstalled"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart">
        <!-- v5 远程载荷：下载地址/文件名/哈希/大小全部写在 ExePackagePayload（v3 的 RemotePayload 已并入） -->
        <ExePackagePayload Name="windowsdesktop-runtime-$(var.DotNetVersion)-win-x64.exe"
                           DownloadUrl="$(var.DotNetUrl)"
                           ProductName="Microsoft .NET Desktop Runtime"
                           Description="Microsoft .NET Desktop Runtime"
                           Version="$(var.DotNetVersion)"
                           Hash="$(var.DotNetSha1)"
                           Size="$(var.DotNetSize)" />
      </ExePackage>

      <!-- Windows App Runtime：无可靠检测锚点，始终运行官方安装器（幂等，已装时秒退） -->
      <ExePackage Id="WindowsAppRuntime"
                  DisplayName="Windows App Runtime 1.8 (x64)"
                  Description="松月启动器运行所需的 Windows App SDK 运行时（首次安装时自动下载）"
                  PerMachine="yes"
                  Permanent="yes"
                  InstallArguments="/quiet /norestart">
        <!-- 无 DetectCondition：每次安装都运行（幂等，已装时秒退）。带 RepairArguments 会要求检测条件，故不写 -->
        <ExePackagePayload Name="windowsappruntimeinstall-x64.exe"
                           DownloadUrl="$(var.WarUrl)"
                           ProductName="Windows App Runtime 1.8"
                           Description="Windows App Runtime 1.8"
                           Version="1.8"
                           Hash="$(var.WarSha1)"
                           Size="$(var.WarSize)" />
      </ExePackage>

      <!-- 应用本体：内部 MajorUpgrade 会识别并替换旧版自包含 MSI（同 UpgradeCode）；
           Visible=no 使 ARP（应用和功能）只显示 Bundle 一条 -->
      <MsiPackage Id="SongYueLauncher"
                  SourceFile="$(var.MsiPath)"
                  Visible="no"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
