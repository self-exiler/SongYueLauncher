<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    松月启动器 MSI 打包源（WiX v4）。
    应用文件清单不在这里手写：WiX v4 无内置目录收割（Files 元素是 v5 才有的），
    由 installer/build.ps1 扫描发布目录生成 harvest.wxs 一起编译。

    变量由 build.ps1 通过 wix build -d 注入：
      PublishDir      发布产物目录（自包含，含 Windows App SDK 运行时）
      ProductVersion  Windows Installer 版本号，只允许数字段（0.1.0）
      Manufacturer    发布者
      UpgradeCode     固定 GUID，升级识别用，切勿改动
      IconPath        应用图标 .ico
  -->
  <Package Name="松月启动器 (A ComfyUI Launcher for ROCm)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           InstallerVersion="500"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades：ProductVersion 只有数字段（0.1.0），重打同一版本时
         ProductCode 会变，默认策略会把它当成「已装别的版本」直接拒装。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更新版本的松月启动器，本次安装中止。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ARP 的 InstallLocation 默认不填，卸载与第三方升级工具按它定位安装目录，必须显式给出 -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- 图标：
         Icon/@Id 以 .exe 结尾 —— ARP（“应用和功能”/资源管理器显示的 msi 图标）才会按 32x32 渲染，
         以 .ico 结尾时系统只取 16x16。
         ARP 图标必须用 Property 显式声明：WiX v4 里 WixVariable Id="ARPPRODUCTICON" 是空操作，
         实测产出的 MSI 里没有该属性，资源管理器里就是一个空白图标。 -->
    <Icon Id="AppIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SongYueLauncher" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="SongYueLauncher" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ApplicationShortcuts" Directory="AppMenuFolder">
      <Component Guid="*">
        <!-- 卸载时清掉开始菜单目录，否则 ICE64 报「用户配置目录未登记 RemoveFile」 -->
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\SongYueLauncher"
                       Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Name="松月启动器"
                  Target="[INSTALLFOLDER]ComfyUiRocmLauncher.GUI.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
      </Component>
      <Component Directory="DesktopFolder" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\SongYueLauncher"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="DesktopShortcut" Name="松月启动器"
                  Target="[INSTALLFOLDER]ComfyUiRocmLauncher.GUI.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
      </Component>
    </ComponentGroup>

    <Feature Id="SongYueLauncherFeature" Title="松月启动器" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>
  </Package>
</Wix>
