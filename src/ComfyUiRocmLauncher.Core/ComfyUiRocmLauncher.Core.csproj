<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ComfyUiRocmLauncher.Core</RootNamespace>
    <AssemblyName>ComfyUiRocmLauncher.Core</AssemblyName>
  </PropertyGroup>

  <!-- WMI 读取显卡型号（FR-1.3）。Core 保持零 UI 依赖，不引用任何 WinUI / WindowsAppSDK 类型。 -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!-- AI 诊断通用能力（opencode 调用 / 进程执行 / 日志扫描 / 提示词模板），与域无关。 -->
  <ItemGroup>
    <ProjectReference Include="..\AiDiagnostics\AiDiagnostics.csproj" />
  </ItemGroup>

  <!-- 单测访问内部解析辅助方法（opencode 输出契约） -->
  <ItemGroup>
    <InternalsVisibleTo Include="ComfyUiRocmLauncher.Core.Test" />
  </ItemGroup>

  <!-- 数据驱动资源：启动参数清单（附录 A）与 GPU 模板（附录 B）随程序集内嵌，GUI 与测试共用同一份。 -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\cli-args.json" />
    <EmbeddedResource Include="Resources\gpu-templates.json" />
    <EmbeddedResource Include="Resources\wheel-catalog.json" />
    <!-- 轮子清单同时以外部文件形式随输出/发布（exe 同目录可替换，更新清单无需重新发版）；
         内嵌副本仅作外部文件缺失/损坏时的回落。 -->
    <Content Include="Resources\wheel-catalog.json" Link="wheel-catalog.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\gpu-arch-map.json" />
  </ItemGroup>

</Project>
