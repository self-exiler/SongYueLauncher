{
  "version": 1,
  "source": "SRS 附录 B（comfyui-rocm.bat 复刻）",
  "comment": "占位符 {comfyUiDir} = ComfyUI 目录，{venvDir} = venv 目录，应用模板时替换。args 为结构化参数数组：flag 型只有 name，带值型含 value。",
  "commonEnvVars": {
    "COMFYUI_ENABLE_MIOPEN": "0",
    "FLASH_ATTENTION_TRITON_AMD_ENABLE": "TRUE",
    "MIOPEN_FIND_ENFORCE": "1",
    "MIOPEN_FIND_MODE": "2",
    "MIOPEN_DEBUG_DISABLE_FIND_DB": "0",
    "MIOPEN_SEARCH_CUTOFF": "1",
    "MIOPEN_ENABLE_LOGGING": "0",
    "MIOPEN_LOG_LEVEL": "0",
    "MIOPEN_ENABLE_LOGGING_CMD": "0",
    "TRITON_PRINT_AUTOTUNING": "0",
    "TRITON_CACHE_AUTOTUNING": "0",
    "TRITON_CACHE_DIR": "{comfyUiDir}\\triton-cache",
    "PYTORCH_TUNABLEOP_CACHE_DIR": "{comfyUiDir}\\tunableop-cache",
    "MIOPEN_SYSTEM_DB_PATH": "{venvDir}\\Lib\\site-packages\\_rocm_sdk_devel\\bin",
    "ROCBLAS_TENSILE_DB_PATH": "{venvDir}\\Lib\\site-packages\\_rocm_sdk_devel\\bin\\rocblas",
    "ROCBLAS_TENSILE_LIBPATH": "{venvDir}\\Lib\\site-packages\\_rocm_sdk_devel\\bin\\rocblas\\library"
  },
  "templates": [
    {
      "id": "rdna12",
      "title": "RDNA1/2（gfx101x / gfx103x）",
      "excludeCommonEnvVars": [],
      "extraEnvVars": {
        "TORCH_BACKENDS_CUDA_FLASH_SDP_ENABLED": "0",
        "TORCH_BACKENDS_CUDA_MEM_EFF_SDP_ENABLED": "0",
        "TORCH_BACKENDS_CUDA_MATH_SDP_ENABLED": "1"
      },
      "args": [
        { "name": "disable-api-nodes" },
        { "name": "cache-lru", "value": "20" },
        { "name": "disable-smart-memory" },
        { "name": "disable-pinned-memory" },
        { "name": "enable-manager" },
        { "name": "enable-manager-legacy-ui" },
        { "name": "disable-triton-backend" },
        { "name": "enable-dynamic-vram" },
        { "name": "use-quad-cross-attention" }
      ]
    },
    {
      "id": "rdna3",
      "title": "RDNA3（gfx110x）",
      "excludeCommonEnvVars": ["MIOPEN_SYSTEM_DB_PATH", "ROCBLAS_TENSILE_DB_PATH", "ROCBLAS_TENSILE_LIBPATH"],
      "extraEnvVars": {
        "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL": "1"
      },
      "args": [
        { "name": "disable-api-nodes" },
        { "name": "cache-lru", "value": "20" },
        { "name": "disable-smart-memory" },
        { "name": "disable-pinned-memory" },
        { "name": "enable-manager" },
        { "name": "enable-manager-legacy-ui" },
        { "name": "disable-triton-backend" },
        { "name": "enable-dynamic-vram" }
      ]
    },
    {
      "id": "rdna4",
      "title": "RDNA4（gfx120x）",
      "excludeCommonEnvVars": [],
      "extraEnvVars": {
        "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL": "1"
      },
      "args": [
        { "name": "enable-manager" },
        { "name": "enable-manager-legacy-ui" },
        { "name": "use-ck-attention" }
      ]
    }
  ]
}
