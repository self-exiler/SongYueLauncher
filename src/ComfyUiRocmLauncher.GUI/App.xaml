<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ComfyUiRocmLauncher.GUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ComfyUiRocmLauncher.GUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Windows 11 设置（Settings）风格统一度量 ===== -->
            <!-- 页面内容铺满可用宽度，只留 SettingsPagePadding，不设最大宽度。
                 若将来要加上限：用「单星号列 + MaxWidth」实现（列封顶后从左侧起排），
                 切勿把 MaxWidth 直接加在 StackPanel/Grid 上——那会被 WinUI 居中。 -->
            <Thickness x:Key="SettingsPagePadding">36,4,36,36</Thickness>
            <x:Double x:Key="SettingsCardMinHeight">48</x:Double>

            <!-- 同一分组内相邻设置卡的间距（Windows 设置卡片近贴排布，非 8 大间距） -->
            <x:Double x:Key="SettingsCardSpacing">2</x:Double>

            <!-- 主窗口页头（大标题/面包屑行）内边距：左右与 SettingsPagePadding 对齐，单一来源 -->
            <Thickness x:Key="SettingsHeaderPadding">36,8,36,0</Thickness>

            <!-- 分组标题：基于内置 Subtitle 文本样式（上疏下密） -->
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,24,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 页面首个分组标题：页面上沿已有 Padding，不能再用 24 的上间距（此前靠 4 处复写 Margin 实现） -->
            <Style x:Key="SettingsSectionHeaderFirstStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource SettingsSectionHeaderStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- 输入类控件的统一宽度（下拉框 / 单行文本框），避免各页 240/260/340/520 混用 -->
            <x:Double x:Key="SettingsFieldMinWidth">320</x:Double>
            <x:Double x:Key="SettingsFieldMaxWidth">480</x:Double>

            <!-- 设置卡内容列统一宽度：SettingsCard 的内容列按各卡内容自适应，宽度不一会让
                 右侧控件的左缘逐卡错位；把内容套进同一宽度的容器即可全页对齐（内含控件 Stretch 填充） -->
            <x:Double x:Key="SettingsCardContentWidth">460</x:Double>

            <!-- 卡片容器：无内边距（供分隔线全幅贴边）；行内边距由 SettingsRowStyle 负责 -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- 卡片内一行：统一水平/垂直内边距与最小行高（Windows 设置行节奏） -->
            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="{StaticResource SettingsCardMinHeight}" />
            </Style>

            <!-- 卡片内容栈：卡片里不是"标题+右侧控件"行、而是一段内容（说明、控件、按钮）时用它，
                 取代 11 处手写 Padding="16,12"（注意 TargetType 必须是 StackPanel，
                 不能套上面的 SettingsRowStyle —— 那个只适用于 Grid） -->
            <Style x:Key="SettingsCardStackStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <!-- 卡片内标题（基于内置 BodyStrong） -->
            <Style x:Key="CardTitleStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 卡片内次级说明文字（基于内置 Caption + 次级前景） -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 卡片内行分隔线 -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- 等宽（命令 / 路径 / 日志） -->
            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

            <!-- 任务/日志控制台：始终终端配色（单点定义，浅/深主题下不变） -->
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#161616" />
            <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#E8E8E8" />
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
