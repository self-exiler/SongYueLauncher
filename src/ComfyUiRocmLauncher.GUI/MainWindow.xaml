<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ComfyUiRocmLauncher.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComfyUiRocmLauncher.GUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="松月启动器"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="松月启动器">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 导航跟随窗口宽度自适应（Windows 设置行为）：宽=展开、中=仅图标、窄=菜单按钮。
             菜单按钮只在非展开态显示，展开态不占页头一行；返回按钮仅在二级页出现。 -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged"
                        BackRequested="NavView_BackRequested"
                        DisplayModeChanged="NavView_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="HomePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="环境与更新" Tag="EnvUpdatePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- CommandPrompt 而非 Setting 齿轮：避免与「环境与更新」的系统设置语义混淆 -->
                <NavigationViewItem Content="启动参数" Tag="ArgsPage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="环境变量" Tag="EnvVarsPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Manage" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="LogPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 设置应用风格页头：左侧标题/面包屑占满剩余宽度，右侧状态徽章固定一列；
                     窄窗口先裁剪标题，不再出现标题与徽章互相压叠 -->
                <Grid Grid.Row="0" Padding="{StaticResource SettingsHeaderPadding}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock x:Name="PageTitle" Text="主页" Style="{StaticResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <!-- 二级页时大标题变身面包屑（Win11 设置风格）：父级段可点击返回 -->
                        <Grid x:Name="PageBreadcrumb" ColumnSpacing="8" Visibility="Collapsed"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CrumbParent" Click="CrumbParent_Click" Padding="0" Margin="0"
                                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    FontSize="{ThemeResource TitleTextBlockFontSize}" FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CrumbCurrent" Grid.Column="2" Style="{StaticResource TitleTextBlockStyle}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <Border x:Name="StateBadge" Grid.Column="1" Padding="12,4" CornerRadius="12"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <TextBlock x:Name="StateTextBlock" Text="已停止" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                </Grid>

                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
