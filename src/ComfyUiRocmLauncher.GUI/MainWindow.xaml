<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ComfyUiRocmLauncher.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComfyUiRocmLauncher.GUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="松月启动器"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="松月启动器">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="HomePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="环境与更新" Tag="EnvUpdatePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="配置管理" Tag="ConfigPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动参数" Tag="ArgsPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="环境变量" Tag="EnvVarsPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Manage" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="LogPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 设置应用风格页头：大标题居左，版本号与运行状态居右，无工具条背景 -->
                <Border Grid.Row="0" Padding="36,8,36,0">
                    <Grid>
                        <TextBlock x:Name="PageTitle" Text="主页" Style="{StaticResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <TextBlock x:Name="VersionText" Text="版本 unknown" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <Border x:Name="StateBadge" Padding="12,4" CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="StateTextBlock" Text="已停止" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
