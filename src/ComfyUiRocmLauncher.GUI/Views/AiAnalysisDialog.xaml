<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ComfyUiRocmLauncher.GUI.Views.AiAnalysisDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignWidth="760" d:DesignHeight="620">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="180" />
        </Grid.RowDefinitions>

        <!-- 模型选择 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="opencode 模型" VerticalAlignment="Center" />
            <ComboBox x:Name="ModelCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                      PlaceholderText="正在读取 opencode 内嵌模型…" />
            <Button x:Name="RefreshModelsButton" Grid.Column="2" Content="刷新模型" Click="RefreshModels_Click" />
        </Grid>

        <!-- 错误日志预览 -->
        <StackPanel Grid.Row="1" Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorSummaryText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <Button x:Name="RecaptureButton" Grid.Column="1" Content="重新抓取" FontSize="12" Padding="8,4" Click="Recapture_Click" />
            </Grid>
            <TextBox x:Name="ErrorPreviewBox"
                     MinHeight="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsSpellCheckEnabled="False"
                     FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <!-- 状态 / 进度 -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />

        <!-- AI 回答（Markdown 渲染） -->
        <Grid Grid.Row="4" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="AI 分析结果" Style="{StaticResource CardTitleStyle}" />
                <!-- IsChecked 不可在 XAML 中预置：解析期触发 Checked 事件时 AnswerMarkdown 尚未创建，程序崩溃 -->
                <ToggleButton x:Name="RenderToggle" Grid.Column="1" FontSize="12" Padding="8,4"
                              Content="原文" Checked="RenderMode_Changed" Unchecked="RenderMode_Changed" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                <ScrollViewer x:Name="AnswerScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 勿在此控件上设置 TextWrapping：Labs 版 MarkdownTextBlock 无该属性，
                             WinUI 1.8 XamlCompiler 会静默崩溃（exit 1 无诊断）。换行由控件内部默认行为负责。 -->
                        <ctrl:MarkdownTextBlock x:Name="AnswerMarkdown" Background="Transparent"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="AnswerText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Visibility="Collapsed"
                                   Text="选择模型并点击「发送给 opencode 分析」。" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
