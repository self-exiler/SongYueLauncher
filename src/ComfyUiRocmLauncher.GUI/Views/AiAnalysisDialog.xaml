<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ComfyUiRocmLauncher.GUI.Views.AiAnalysisDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignWidth="920" d:DesignHeight="600">

    <!-- 重构原型 v2（docs/prototypes/ai-analysis-dialog-v2.html）：
         顶部模型栏 / 中部两栏（问题日志｜回答 + 竖排按钮列）/ 底部状态栏。
         宿主为独立窗口 AiAnalysisWindow（标题栏 X 关闭），发送 / 复制 / 重新抓取全部内聚在本控件。
         高度用 MinHeight 而非固定值：窗口可拉伸，两栏随需放大。 -->
    <Grid MinHeight="520" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部：模型栏 ===== -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="opencode 模型" VerticalAlignment="Center" />
            <ComboBox x:Name="ModelCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                      PlaceholderText="正在读取 opencode 内嵌模型…" />
            <Button x:Name="RefreshModelsButton" Grid.Column="2" Content="刷新模型" Click="RefreshModels_Click" />
        </Grid>

        <!-- ===== 中部：两栏 ===== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：问题日志 -->
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="问题日志" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ErrorSummaryText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="ErrorPreviewBox" Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsSpellCheckEnabled="False"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!-- 右栏：回答区 + 竖排按钮列 -->
            <Grid Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto">
                        <!-- 勿在此控件上设置 TextWrapping：Labs 版 MarkdownTextBlock 无该属性，
                             WinUI 1.8 XamlCompiler 会静默崩溃（exit 1 无诊断）。换行由控件内部默认行为负责。 -->
                        <ctrl:MarkdownTextBlock x:Name="AnswerMarkdown" Background="Transparent"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Column="1" Width="132" Spacing="8">
                    <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="Send_Click">
                        <TextBlock x:Name="SendButtonText" Text="发送给 opencode 分析"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <Button x:Name="CopyButton" Content="复制回答" IsEnabled="False"
                            HorizontalAlignment="Stretch" Click="Copy_Click" />
                    <Button x:Name="RecaptureButton" Content="重新抓取"
                            HorizontalAlignment="Stretch" Click="Recapture_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 底部：状态栏 ===== -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{ThemeResource TextFillColorDisabledBrush}" />
                <TextBlock x:Name="StatusText" Text="就绪。" Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
