<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 内容宽度上限用「单星号列 + MaxWidth」实现，列宽封顶后仍从左侧起排（左对齐）。
         切勿把 MaxWidth 直接加在 StackPanel 上：WinUI 对「Stretch + MaxWidth」会居中，最大化后看着偏右。 -->
    <Grid Padding="{StaticResource SettingsPagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsPageMaxWidth}" />
        </Grid.ColumnDefinitions>

        <ScrollViewer>
            <StackPanel>

                <!-- ===== 模板选择 ===== -->
                <TextBlock Text="GPU 架构模板" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}" Spacing="12">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="集中选择 GPU 代际默认模板。应用为全量替换：当前环境变量与启动参数会被整体改写为模板内容，之后仍可在“启动参数 / 环境变量”页自由编辑。" />
                        <ComboBox x:Name="TemplateCombo" Header="模板"
                                  MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="{StaticResource SettingsFieldMaxWidth}"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Title" SelectionChanged="TemplateCombo_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyButton" Content="应用模板" Style="{StaticResource AccentButtonStyle}"
                                    Click="Apply_Click" />
                            <Button x:Name="SaveAsButton" Content="当前配置另存为自定义模板" Click="SaveAs_Click" />
                            <Button x:Name="DeleteButton" Content="删除自定义模板" IsEnabled="False" Click="Delete_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="自定义模板保存当前环境变量与启动参数的全量快照，其中的 ComfyUI 目录 / venv 路径存为 {comfyUiDir} / {venvDir} 占位符，换目录后仍可用。" />
                        <TextBlock x:Name="SelectedInfoText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ActionStatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ===== 导出启动脚本 ===== -->
                <TextBlock Text="导出启动脚本" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="把当前配置（ComfyUI 目录、Python 解释器、环境变量、启动参数）导出为可直接运行 Windows PowerShell 的 .ps1，用于脱离启动器启动、做桌面快捷方式或计划任务。脚本与启动器同源：固定注入层、自定义环境变量、GitHub 镜像与缓存目录都由脚本自己处理。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportPs1Button" Content="导出为 .ps1" Style="{StaticResource AccentButtonStyle}"
                                    Click="ExportPs1_Click" />
                            <Button x:Name="CopyPs1Button" Content="复制脚本内容" Click="CopyPs1_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ExportStatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
