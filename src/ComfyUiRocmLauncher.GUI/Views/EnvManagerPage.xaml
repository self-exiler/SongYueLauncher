<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.EnvManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 运行中保护：设置应用用 InfoBar 承载这类提示 -->
        <InfoBar x:Name="GuardBanner" Grid.Row="0" Margin="36,4,36,0" IsOpen="False" IsClosable="False"
                 Severity="Warning" Title="环境管理操作已禁用"
                 Message="ComfyUI 正在运行 / 环境任务进行中（FR-6.4 运行中保护）" />

        <!-- ===== 维护任务 ===== -->
        <StackPanel Grid.Row="1" Margin="36,8,36,8" MaxWidth="{StaticResource SettingsPageMaxWidth}"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="维护任务" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,0,0,8" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16,12" Spacing="8">
                        <TextBlock Text="ROCm / PyTorch 更新" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="detect_gpu.py 取 arch → 卸载旧组件 → 按 arch 从 AMD nightly 源安装 → rocm-sdk init → 验证。" />
                        <Button x:Name="RocmButton" Content="开始更新" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Click="RocmUpdate_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16,12" Spacing="8">
                        <TextBlock Text="通用依赖安装" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="过滤 torch 系后 uv pip install，完成后对比 pip freeze 输出变更包列表。" />
                        <CheckBox x:Name="MirrorCheck" Content="使用国内镜像源" />
                        <Button x:Name="DepsButton" Content="开始安装" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Click="Deps_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ===== 任务输出 ===== -->
        <StackPanel Grid.Row="2" Margin="36,8,36,24" MaxWidth="{StaticResource SettingsPageMaxWidth}"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="任务输出" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TaskStatusText" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelButton" Content="取消（终止子进程）" IsEnabled="False" Click="Cancel_Click" />
                            <Button Content="清屏" Click="ClearOutput_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />
                    <ScrollViewer x:Name="TaskScroll" Grid.Row="2" Padding="12" Background="#FF161616"
                                  CornerRadius="0,0,8,8">
                        <TextBlock x:Name="TaskOutputText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12.5"
                                   Foreground="#FFE8E8E8"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
