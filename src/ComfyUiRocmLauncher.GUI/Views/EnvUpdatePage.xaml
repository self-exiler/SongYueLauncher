<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.EnvUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8" Padding="{StaticResource SettingsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScroll" Grid.Row="0">
            <!-- 内容铺满可用宽度（左右只留页面边距）；底部控制台单独整宽 -->
            <StackPanel>

                <!-- 分节结构统一为「标题 + 卡片栈」：卡间距交给卡片栈的 Spacing，
                     不再逐张写 Margin="0,8,0,0"（此前同一个 8 重复了 5 次） -->

                <!-- ============ 工具链 ============ -->
                <TextBlock Text="工具链" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                <StackPanel Spacing="8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="外部工具" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="检测 PATH 与已知安装路径。安装经 winget（可能弹 UAC）；uv 亦支持用户级安装免 UAC。" />
                            <StackPanel x:Name="ToolList" Spacing="8" />
                            <Button x:Name="RedetectButton" Content="重新检测" Click="Redetect_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="GPU 架构（自动检测）" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="ArchText" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="下载镜像源" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="GitHub 镜像作用于 git clone、GitHub release 轮子，注入 ComfyUI 的 GITHUB_ENDPOINT，并从下次启动起接管 ComfyUI-Manager 的数据通道（channels.list / config.ini）；ComfyUI-Manager 装节点前判定风险等级时仍会直连一次 GitHub。PyPI 镜像仅作用于通用包与项目依赖；AMD 官方源永远直连。镜像清单为固定候选，公共镜像可用性会随时间变化，失效时切换另一项或选「直连」。" />
                            <ComboBox x:Name="GithubMirrorBox" Header="GitHub 加速镜像"
                                      MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="{StaticResource SettingsFieldMaxWidth}"
                                      HorizontalAlignment="Left"
                                      DisplayMemberPath="Display" SelectionChanged="GithubMirrorBox_SelectionChanged" />
                            <ComboBox x:Name="PypiMirrorBox" Header="PyPI 镜像"
                                      MinWidth="{StaticResource SettingsFieldMinWidth}" MaxWidth="{StaticResource SettingsFieldMaxWidth}"
                                      HorizontalAlignment="Left"
                                      DisplayMemberPath="Display" SelectionChanged="PypiMirrorBox_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ComfyUI 项目 ============ -->
                <TextBlock Text="ComfyUI 项目" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <StackPanel Spacing="8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="仓库与安装" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="上游默认仓库已删除，仓库地址需自行指定。安装目录取主页「ComfyUI 目录」。" />
                            <TextBox x:Name="RepoUrlBox" Header="仓库地址（HTTPS git URL）" PlaceholderText="https://github.com/owner/repo.git"
                                     TextChanged="RepoUrlBox_TextChanged" />
                            <TextBlock x:Name="ProjectStatusText" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click" />
                                <Button x:Name="CloneButton" Content="克隆安装" Style="{StaticResource AccentButtonStyle}" Click="Clone_Click" />
                                <Button x:Name="PullButton" Content="拉取更新" Click="Pull_Click" />
                                <Button x:Name="ForceButton" Content="强制覆盖更新" Click="Force_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Python 轮子 ============ -->
                <TextBlock Text="Python 轮子" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <StackPanel Spacing="8">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="Python 虚拟环境" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="VenvStatusText" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CreateVenvButton" Content="创建 .venv（Python 3.12）" Click="CreateVenv_Click" />
                                <Button x:Name="OpenTerminalButton" Content="在终端中激活环境" Click="OpenTerminal_Click" ToolTipService.ToolTip="打开 Windows Terminal，工作目录为 ComfyUI 目录并激活 .venv" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="PyTorch for ROCm（nightly）" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="先下载验证再卸载；中断可尽力回滚到快照（原版本可能已下架）。AMD 源直连。" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TorchUpdateButton" Content="更新 torch" Style="{StaticResource AccentButtonStyle}" Click="TorchUpdate_Click" />
                                <Button x:Name="RollbackButton" Content="回滚到快照" Click="Rollback_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 初次部署顺序：建 venv → 装 torch → 装项目通用依赖 → 装作者专用轮子（与整合包 install.bat 同序） -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="项目通用依赖（requirements / manager / agent 三清单）" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="依序安装整合包 requirements.txt、manager_requirements.txt、agent_requirements.txt 列出的通用 whl 包（后两个不存在时自动跳过；torch / torchvision / torchaudio 已剔除，由上方「PyTorch for ROCm」单独管理）。初次部署在装完 torch 后执行本步，再装下方专用轮子。" />
                            <Button x:Name="DepsButton" Content="安装项目依赖" Style="{StaticResource AccentButtonStyle}" Click="SyncDeps_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                            <TextBlock Text="作者专用轮子" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="CatalogVersionText" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="WheelListText" FontFamily="{StaticResource MonoFontFamily}" Style="{StaticResource SecondaryTextStyle}" />
                            <Button x:Name="WheelsButton" Content="安装专用轮子" Click="InstallWheels_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- 二级页入口卡（Windows 设置 drill-in 风格：整卡可点，右侧 chevron） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Button x:Name="PackagesEntryButton" Click="PackagesOpen_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="通用 PyPI 包" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="查看已装列表、按包名 / 版本 / whl URL 安装与卸载"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ 二级页：通用 PyPI 包（覆盖主内容区；返回入口为页头大标题面包屑） ============ -->
        <ScrollViewer x:Name="PackagesPanel" Grid.Row="0" Visibility="Collapsed">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Text="已装包列表" Style="{StaticResource CardTitleStyle}" />
                        <Button x:Name="RefreshListButton" Content="刷新已装列表" Click="RefreshPackages_Click" HorizontalAlignment="Left" />
                        <TextBox x:Name="PackageListText" AcceptsReturn="True" IsReadOnly="True" MinHeight="200"
                                 FontFamily="{StaticResource MonoFontFamily}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Text="安装 / 卸载" Style="{StaticResource CardTitleStyle}" />
                        <TextBox x:Name="PackageInputBox" Header="包名、包名==版本 或 whl URL" PlaceholderText="einops==0.8.0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PkgInstallButton" Content="安装" Style="{StaticResource AccentButtonStyle}" Click="InstallPackage_Click" />
                            <Button x:Name="PkgUninstallButton" Content="卸载" Click="UninstallPackage_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 共享任务控制台（始终终端深色；标题行右侧可折叠，为上方内容腾出空间） ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" Background="{StaticResource ConsoleBackgroundBrush}">
            <Grid Padding="12,8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 定高：Auto 行会随输出无限撑高，滚动条永远不出现；折叠由代码置 0 -->
                    <RowDefinition x:Name="ConsoleRow" Height="200" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="任务输出" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"
                                   Foreground="{StaticResource ConsoleForegroundBrush}" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" />
                        <Button Content="清空" Click="ClearConsole_Click" />
                        <TextBlock x:Name="ConsoleHintText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                   Foreground="{StaticResource ConsoleForegroundBrush}" />
                    </StackPanel>
                    <Button x:Name="ConsoleToggleButton" Grid.Column="1" Click="ToggleConsole_Click"
                            ToolTipService.ToolTip="折叠/展开任务输出区">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ConsoleToggleGlyph" Glyph="&#xE70D;" FontSize="12" />
                            <TextBlock x:Name="ConsoleToggleLabel" Text="收起" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="ConsoleScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ConsoleText" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                               Foreground="{StaticResource ConsoleForegroundBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
