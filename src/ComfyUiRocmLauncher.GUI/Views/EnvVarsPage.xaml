<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.EnvVarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource SettingsPagePadding}">
        <StackPanel MaxWidth="{StaticResource SettingsPageMaxWidth}" HorizontalAlignment="Stretch">

            <!-- ===== 固定注入层（只读） ===== -->
            <TextBlock Text="固定注入层（只读）" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PYTHONUTF8" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PYTHONNOUSERSITE" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PATH" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="venv 与 Scripts 前置" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="HIP_PATH" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="启动时执行 rocm-sdk path --root 的输出" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ROCM_PATH" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="同上" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ===== 自定义层 ===== -->
            <TextBlock Text="自定义层" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                    <TextBlock Text="key 与固定注入层冲突时禁止保存并提示。" Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel x:Name="CustomRows" Spacing="8" />
                    <Button Content="添加变量" Click="AddRow_Click" HorizontalAlignment="Left" />
                    <InfoBar x:Name="ConflictBar" Severity="Error" IsClosable="False" IsOpen="False" />
                </StackPanel>
            </Border>

            <!-- ===== 启动前自动步骤 ===== -->
            <TextBlock Text="启动前自动步骤" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                    <TextBlock Text="复刻 comfyui-rocm.bat 的启动前流程" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="1. 执行 rocm-sdk init（失败仅警告，不阻断）" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="2. 执行 rocm-sdk path --root 推导 HIP_PATH / ROCM_PATH（失败警告）" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="3. 确保 TRITON_CACHE_DIR、PYTORCH_TUNABLEOP_CACHE_DIR 指向的目录存在" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
