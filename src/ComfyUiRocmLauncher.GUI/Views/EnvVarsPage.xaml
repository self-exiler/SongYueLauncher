<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.EnvVarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <!-- 内容铺满可用宽度（左右只留页面边距）。若将来要加上限，必须用「单星号列 + MaxWidth」实现，
         切勿把 MaxWidth 直接加在 StackPanel 上：WinUI 对「Stretch + MaxWidth」会居中，会表现为内容偏右。 -->
    <Grid Padding="{StaticResource SettingsPagePadding}">
        <ScrollViewer>
            <StackPanel>

                <!-- ===== 固定注入层（只读） ===== -->
                <TextBlock Text="固定注入层（只读）" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <settings:SettingsCard>
                        <settings:SettingsCard.Header>
                            <TextBlock Text="PYTHONUTF8" FontFamily="{StaticResource MonoFontFamily}" />
                        </settings:SettingsCard.Header>
                        <TextBlock Text="1" Style="{StaticResource SecondaryTextStyle}" />
                    </settings:SettingsCard>
                    <settings:SettingsCard>
                        <settings:SettingsCard.Header>
                            <TextBlock Text="PYTHONNOUSERSITE" FontFamily="{StaticResource MonoFontFamily}" />
                        </settings:SettingsCard.Header>
                        <TextBlock Text="1" Style="{StaticResource SecondaryTextStyle}" />
                    </settings:SettingsCard>
                    <settings:SettingsCard>
                        <settings:SettingsCard.Header>
                            <TextBlock Text="PATH" FontFamily="{StaticResource MonoFontFamily}" />
                        </settings:SettingsCard.Header>
                        <TextBlock Text="venv 与 Scripts 前置" Style="{StaticResource SecondaryTextStyle}" />
                    </settings:SettingsCard>
                    <settings:SettingsCard>
                        <settings:SettingsCard.Header>
                            <TextBlock Text="HIP_PATH" FontFamily="{StaticResource MonoFontFamily}" />
                        </settings:SettingsCard.Header>
                        <TextBlock Text="启动时执行 rocm-sdk path --root 的输出" Style="{StaticResource SecondaryTextStyle}" />
                    </settings:SettingsCard>
                    <settings:SettingsCard>
                        <settings:SettingsCard.Header>
                            <TextBlock Text="ROCM_PATH" FontFamily="{StaticResource MonoFontFamily}" />
                        </settings:SettingsCard.Header>
                        <TextBlock Text="同上" Style="{StaticResource SecondaryTextStyle}" />
                    </settings:SettingsCard>
                </StackPanel>

                <!-- ===== 自定义层 ===== -->
                <TextBlock Text="自定义层" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Text="key 与固定注入层冲突时禁止保存并提示。" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel x:Name="CustomRows" Spacing="8" />
                        <Button Content="添加变量" Click="AddRow_Click" HorizontalAlignment="Left" />
                        <InfoBar x:Name="ConflictBar" Severity="Error" IsClosable="False" IsOpen="False" />
                    </StackPanel>
                </Border>

                <!-- ===== 启动前自动步骤 ===== -->
                <TextBlock Text="启动前自动步骤" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Text="复刻 comfyui-rocm.bat 的启动前流程" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="1. 执行 rocm-sdk init（失败仅警告，不阻断）" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="2. 执行 rocm-sdk path --root 推导 HIP_PATH / ROCM_PATH（失败警告）" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="3. 确保 TRITON_CACHE_DIR、PYTORCH_TUNABLEOP_CACHE_DIR 指向的目录存在" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
