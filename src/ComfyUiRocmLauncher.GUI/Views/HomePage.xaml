<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 内容铺满可用宽度（左右只留页面边距）。若将来要加上限，必须用「单星号列 + MaxWidth」实现，
         切勿把 MaxWidth 直接加在 StackPanel 上：WinUI 对「Stretch + MaxWidth」会居中，会表现为内容偏右。 -->
    <Grid Padding="{StaticResource SettingsPagePadding}">
        <ScrollViewer>
            <StackPanel>

                <!-- ===== 路径设置 ===== -->
                <TextBlock Text="路径设置" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ComfyUI 目录" VerticalAlignment="Center" />
                            <TextBox x:Name="ComfyDirBox" Grid.Column="1"
                                     PlaceholderText="整合包解压目录（需含 main.py）"
                                     TextChanged="ComfyDirBox_TextChanged" />
                            <Button Grid.Column="2" Content="浏览…" MinWidth="96" Click="BrowseComfyDir_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Python 解释器" VerticalAlignment="Center" />
                            <TextBox x:Name="PythonBox" Grid.Column="1"
                                     PlaceholderText="&lt;ComfyUI目录&gt;\.venv\Scripts\python.exe"
                                     TextChanged="PythonBox_TextChanged" />
                            <Button Grid.Column="2" Content="浏览…" MinWidth="96" Click="BrowsePython_Click" />
                            <Button Grid.Column="3" Content="验证" MinWidth="96" Click="VerifyPython_Click" />
                            <TextBlock x:Name="PythonVerifyText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock x:Name="UvStatusText" Text="uv.exe：检查中…"
                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 启动控制 ===== -->
                <TextBlock Text="启动控制" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="运行 ComfyUI" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="启动后可停止；自动打开浏览器请在「启动参数」中启用 --auto-launch"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="104" Click="Start_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopButton" MinWidth="104" IsEnabled="False" Click="Stop_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="停止" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BrowserButton" Content="打开浏览器" MinWidth="116" IsEnabled="False"
                                        Click="OpenBrowser_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <!-- GPU 架构模板（原配置管理页 FR-7，应用为全量替换） -->
                        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU 架构模板" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="应用模板会把当前环境变量与启动参数整体替换为模板内容，之后仍可在「启动参数 / 环境变量」页编辑。自定义模板中的目录路径存为占位符，换目录仍可用。" />
                            <ComboBox x:Name="TemplateCombo" Grid.Column="1" MaxWidth="420" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Title" SelectionChanged="TemplateCombo_SelectionChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ApplyButton" Content="应用模板" Style="{StaticResource AccentButtonStyle}"
                                        Click="Apply_Click" />
                                <Button x:Name="SaveAsButton" Content="另存为模板" Click="SaveAs_Click" />
                                <Button x:Name="DeleteButton" Content="删除模板" IsEnabled="False" Click="Delete_Click" />
                            </StackPanel>
                            <!-- 只在应用/另存/删除后显示一行反馈，平时为空不占位 -->
                            <TextBlock x:Name="TemplateStatusText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <!-- 导出启动脚本（原配置管理页，脱离启动器直接跑） -->
                        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="导出启动脚本" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="把当前配置（目录、解释器、环境变量、参数）导出为可在 Windows PowerShell 直接运行的 .ps1，用于桌面快捷方式或计划任务。" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ExportPs1Button" Content="导出为 .ps1" Click="ExportPs1_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ExportStatusText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 状态 ===== -->
                <TextBlock Text="状态" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="运行状态" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="RunStateDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorDisabledBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RunStateText" Text="已停止" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="当前版本" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionHashText" Grid.Row="1" Grid.Column="1" Text="unknown"
                                   FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU 型号" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuText" Grid.Row="2" Grid.Column="1" Text="读取中…" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ===== 快捷目录 ===== -->
                <TextBlock Text="快捷目录" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource SettingsCardStackStyle}">
                        <TextBlock Text="在文件资源管理器中打开整合包下的常用目录；目录不存在时对应按钮自动禁用。"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="QdOutput" Content="输出目录" ToolTipService.ToolTip="output"
                                    Click="QuickDir_Click" Tag="output" />
                            <Button x:Name="QdModels" Content="模型目录" ToolTipService.ToolTip="models"
                                    Click="QuickDir_Click" Tag="models" />
                            <Button x:Name="QdWorkflow" Content="用户工作流" ToolTipService.ToolTip="user\workflow"
                                    Click="QuickDir_Click" Tag="user\workflow" />
                            <Button x:Name="QdCustomNodes" Content="自定义节点" ToolTipService.ToolTip="custom_nodes"
                                    Click="QuickDir_Click" Tag="custom_nodes" />
                            <Button x:Name="QdInput" Content="输入目录" ToolTipService.ToolTip="input"
                                    Click="QuickDir_Click" Tag="input" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
