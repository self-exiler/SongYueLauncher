<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComfyUiRocmLauncher.GUI.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条（设置应用风格：无卡片背景） -->
        <Grid Grid.Row="0" Margin="36,4,36,8" MaxWidth="{StaticResource SettingsPageMaxWidth}"
              HorizontalAlignment="Stretch" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RetentionText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="自动滚动" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="AutoScrollToggle" IsOn="True" OnContent="" OffContent="" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="清空" Click="Clear_Click" />
                <Button Content="复制全部" Click="CopyAll_Click" />
                <Button Content="打开日志目录" Click="OpenLogDir_Click" />
            </StackPanel>
        </Grid>

        <!-- 控制台：保留终端深色底以保证 ANSI 调色板对比度（颜色取自 App.xaml 令牌） -->
        <Border Grid.Row="1" Margin="36,0,36,24" Style="{StaticResource CardBorderStyle}" Background="{StaticResource ConsoleBackgroundBrush}">
            <ScrollViewer x:Name="LogScroll" Padding="12">
                <TextBlock x:Name="LogText"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="12.5"
                           Foreground="{StaticResource ConsoleForegroundBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
