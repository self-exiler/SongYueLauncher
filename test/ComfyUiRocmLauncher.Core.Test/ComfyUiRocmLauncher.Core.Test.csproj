<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ComfyUiRocmLauncher.Core\ComfyUiRocmLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI 分析 agent 资源属于 GUI 输出目录；测试直接链接同一文件，确保资源路径约定不漂移。 -->
    <Content Include="..\..\src\ComfyUiRocmLauncher.GUI\Assets\Agents\comfyui-error-analyst.json"
             Link="Assets\Agents\comfyui-error-analyst.json"
             CopyToOutputDirectory="PreserveNewest" />
